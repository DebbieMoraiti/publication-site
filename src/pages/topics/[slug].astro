---
import TopicPage from '../../components/TopicPage.astro';
import { activeTopics } from '../../content/publication-data';
import { siteConfig } from '../../config';

export function getStaticPaths() {
  return activeTopics().map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}
const { topic } = Astro.props;
const lang = siteConfig.localization.defaultLanguage as 'en' | 'el';
---
<TopicPage lang={lang} topic={topic} />
