---
import AuthorPage from '../../components/AuthorPage.astro';
import { authors } from '../../content/editorial';
import { siteConfig } from '../../config';

export function getStaticPaths() {
  return authors.map((author) => ({ params: { slug: author.slug }, props: { author } }));
}
const { author } = Astro.props;
const lang = siteConfig.localization.defaultLanguage as 'en' | 'el';
---
<AuthorPage lang={lang} author={author} />
