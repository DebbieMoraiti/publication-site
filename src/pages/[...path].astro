---
import LivePage from '../components/LivePage.astro';
import { enabledSections, moduleConfig, siteConfig } from '../config';
import { languagePath, type LanguageCode } from '../i18n/routes';

export function getStaticPaths() {
  if (!enabledSections.some((section) => section.id === 'live') ||
      !moduleConfig.detailPages.live || !moduleConfig.live.archiveEnabled) return [];
  return siteConfig.localization.languages.map((language) => ({
    params: { path: languagePath(language.code as LanguageCode, 'live').replace(/^\/|\/$/g, '') },
    props: { lang: language.code as LanguageCode },
  }));
}

const { lang } = Astro.props;
---

<LivePage lang={lang} />
