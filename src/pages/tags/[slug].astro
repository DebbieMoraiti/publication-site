---
import TagPage from '../../components/TagPage.astro';
import { publicTagPaths } from '../../content/publication-data';
import { siteConfig } from '../../config';

export function getStaticPaths() {
  const tags = publicTagPaths();
  return tags.map((tag) => ({ params: { slug: tag }, props: { tag } }));
}
const { tag } = Astro.props;
const lang = siteConfig.localization.defaultLanguage as 'en' | 'el';
---
<TagPage lang={lang} tag={tag} />
