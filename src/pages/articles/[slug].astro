---
import ArticlePage from '../../components/ArticlePage.astro';
import { allArticles } from '../../content/publication-data';
import { siteConfig } from '../../config';

export function getStaticPaths() {
  return allArticles().map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const lang = siteConfig.localization.defaultLanguage as 'en' | 'el';
---

<ArticlePage lang={lang} article={article} />
