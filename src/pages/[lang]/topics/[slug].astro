---
import TopicPage from '../../../components/TopicPage.astro';
import { topics } from '../../../content/editorial';
import { secondaryLanguages } from '../../../i18n/routes';

export function getStaticPaths() {
  return secondaryLanguages.flatMap(({ code }) =>
    topics.map((topic) => ({ params: { lang: code, slug: topic.slug }, props: { topic } })),
  );
}
const { topic } = Astro.props;
const lang = Astro.params.lang as 'en' | 'el';
---
<TopicPage lang={lang} topic={topic} />
