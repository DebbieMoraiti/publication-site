---
import ArticlePage from '../../../components/ArticlePage.astro';
import { visibleArticles } from '../../../content/publication-data';
import { secondaryLanguages } from '../../../i18n/routes';

export function getStaticPaths() {
  return secondaryLanguages.flatMap(({ code }) =>
    visibleArticles().map((article) => ({
      params: { lang: code, slug: article.slug },
      props: { article },
    })),
  );
}

const { article } = Astro.props;
const lang = Astro.params.lang as 'en' | 'el';
---

<ArticlePage lang={lang} article={article} />
