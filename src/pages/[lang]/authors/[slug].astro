---
import AuthorPage from '../../../components/AuthorPage.astro';
import { authors } from '../../../content/editorial';
import { secondaryLanguages } from '../../../i18n/routes';

export function getStaticPaths() {
  return secondaryLanguages.flatMap(({ code }) =>
    authors.map((author) => ({ params: { lang: code, slug: author.slug }, props: { author } })),
  );
}
const { author } = Astro.props;
const lang = Astro.params.lang as 'en' | 'el';
---
<AuthorPage lang={lang} author={author} />
