---
import type { LanguageCode } from '../../i18n/ui';
import type { enabledSections } from '../../config';

interface Props {
  section: (typeof enabledSections)[number];
  lang: LanguageCode;
  number: number;
  alternate: boolean;
}

const { section, lang, number, alternate } = Astro.props;
---

<section id={section.id} class:list={['section-shell', { 'alternate-surface': alternate }]} aria-labelledby={`${section.id}-title`}>
  <div class="content-container section-grid">
    <p class="section-number" aria-hidden="true">{String(number).padStart(2, '0')}</p>
    <div class="section-content">
      <h2 id={`${section.id}-title`}>{section.label[lang]}</h2>
      <slot />
    </div>
  </div>
</section>
