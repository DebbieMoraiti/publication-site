---
import pressKit from '../../content/press-kit.json';
import type { LanguageCode } from '../../i18n/ui';
import { safeLink } from '../../content/links';

interface Props { lang: LanguageCode }
const { lang } = Astro.props;
---

{pressKit.intro?.[lang]?.trim() && <p class="section-intro">{pressKit.intro[lang]}</p>}
{safeLink(pressKit.downloadUrl) && <p><a href={safeLink(pressKit.downloadUrl)}>{pressKit.downloadLabel?.[lang] || (lang === 'el' ? 'Λήψη' : 'Download')}</a></p>}
