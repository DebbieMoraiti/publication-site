---
import { siteConfig } from '../config';
import live from '../content/live.json';
import type { LanguageCode } from '../i18n/ui';
import { ui } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import LiveCollection from './sections/LiveCollection.astro';

interface Props { lang: LanguageCode }
const { lang } = Astro.props;
const heading = lang === 'el' ? 'Εμφανίσεις' : 'Live';
---

<BaseLayout lang={lang} title={`${siteConfig.identity.name} — ${heading}`} description={live.intro?.[lang] || undefined} skipText={ui[lang].skipToContent}>
  <div class="site-shell" id="top">
    <SiteHeader lang={lang} />
    <main id="main-content" class="live-page content-container" tabindex="-1">
      <h1>{heading}</h1>
      {live.intro?.[lang]?.trim() && <p class="section-intro">{live.intro[lang]}</p>}
      <LiveCollection lang={lang} archive={true} />
    </main>
    <SiteFooter lang={lang} />
  </div>
</BaseLayout>
