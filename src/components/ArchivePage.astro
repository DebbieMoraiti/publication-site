---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialHeader from './EditorialHeader.astro';
import EditorialFooter from './EditorialFooter.astro';
import { sortedVisibleArticles } from '../content/publication-data';
import { authorBySlug, topicBySlug } from '../content/editorial';
import publication from '../content/publication.json';
import { languagePath, type LanguageCode } from '../i18n/routes';
import { publicationCollectionSchema } from '../lib/publication-schema';

interface Props { lang: LanguageCode; }
const { lang } = Astro.props;
const sorted = sortedVisibleArticles();
const authorMap = authorBySlug;
const topicMap = topicBySlug;
const pageTitle = lang === 'el' ? 'Αρχείο' : 'Archive';
const pageDescription = lang === 'el' ? 'Όλες οι δημοσιεύσεις του publication.' : 'All stories published by the publication.';
const schema = publicationCollectionSchema(lang, 'archive', pageTitle, pageDescription);
---

<BaseLayout
  lang={lang}
  title={`${pageTitle} — ${publication.identity.name}`}
  description={pageDescription}
  structuredData={schema}
>
  <div class="site-shell publication-shell" id="top">
    <EditorialHeader lang={lang} />
    <main id="main-content" tabindex="-1">
      <section class="archive-page content-container">
        <nav class="editorial-breadcrumbs" aria-label={lang === 'el' ? 'Πλοήγηση' : 'Breadcrumb'}>
          <a href={languagePath(lang)}>{lang === 'el' ? 'Αρχική' : 'Home'}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{lang === 'el' ? 'Αρχείο' : 'Archive'}</span>
        </nav>
        <p class="publication-kicker">{lang === 'el' ? 'Όλο το περιεχόμενο' : 'All stories'}</p>
        <h1>{lang === 'el' ? 'Αρχείο' : 'Archive'}</h1>
        <p class="taxonomy-count">{sorted.length} {lang === 'el' ? (sorted.length === 1 ? 'άρθρο' : 'άρθρα') : (sorted.length === 1 ? 'story' : 'stories')}</p>
        <div class="archive-list">
          {sorted.map((article) => {
            const author = authorMap.get(article.author);
            const topic = topicMap.get(article.topicSlug);
            return (
              <article class="archive-item">
                <time datetime={article.date}>{article.date}</time>
                <div>
                  <p class="story-meta">{topic?.label[lang] ?? article.topic?.[lang] ?? article.topicSlug}</p>
                  <h2><a href={languagePath(lang, `articles/${article.slug}`)}>{article.title[lang]}</a></h2>
                  <p>{article.dek[lang]}</p>
                  {author && <a class="archive-author" href={languagePath(lang, `authors/${author.slug}`)}>{author.name}</a>}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    </main>
    <EditorialFooter lang={lang} />
  </div>
</BaseLayout>
