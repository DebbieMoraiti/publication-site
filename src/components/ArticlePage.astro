---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialHeader from './EditorialHeader.astro';
import EditorialFooter from './EditorialFooter.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import publication from '../content/publication.json';
import { authorBySlug, topicBySlug, type Article } from '../content/editorial';
import { articleNeighbors, relatedArticles } from '../content/publication-data';
import { formatPublicationDate } from '../lib/editorial-format';
import { publicationArticleSchema } from '../lib/publication-schema';
import { languagePath, type LanguageCode } from '../i18n/routes';

interface Props {
  lang: LanguageCode;
  article: Article;
}

const { lang, article } = Astro.props;
const body = article.body?.[lang] ?? [];
const sections = article.sections ?? [];
const author = authorBySlug.get(article.author);
const topic = topicBySlug.get(article.topicSlug);
const schema = publicationArticleSchema(lang, article, author);
const { newer, older } = articleNeighbors(article);
const related = relatedArticles(article, 3);
---

<BaseLayout
  lang={lang}
  title={`${article.title[lang]} — ${publication.identity.name}`}
  description={article.dek[lang]}
  noindex={article.status !== 'published'}
  structuredData={schema}
  ogType="article"
  socialImage={article.image}
  socialImageAlt={article.imageAlt?.[lang] || article.title[lang]}
  publishedTime={article.date}
  articleSection={topic?.label[lang] ?? article.topic?.[lang] ?? article.topicSlug}
  skipText={lang === 'el' ? 'Μετάβαση στο περιεχόμενο' : 'Skip to content'}
>
  <div class="site-shell publication-shell" id="top">
    <EditorialHeader lang={lang} />
    <main id="main-content" tabindex="-1">
      <article class="article-page content-container">
        <header class="article-header">
          <nav class="editorial-breadcrumbs" aria-label={lang === 'el' ? 'Πλοήγηση' : 'Breadcrumb'}>
            <a href={languagePath(lang)}>{lang === 'el' ? 'Αρχική' : 'Home'}</a>
            <span aria-hidden="true">/</span>
            <a href={languagePath(lang, `topics/${article.topicSlug}`)}>{topic?.label[lang] ?? article.topic?.[lang] ?? article.topicSlug}</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{article.title[lang]}</span>
          </nav>
          <p class="story-meta">
            <a href={languagePath(lang, `topics/${article.topicSlug}`)}>{topic?.label[lang] ?? article.topic?.[lang] ?? article.topicSlug}</a>
          </p>
          <h1>{article.title[lang]}</h1>
          <p class="article-dek">{article.dek[lang]}</p>
          <p class="article-byline">
            {author && <span>
              {lang === 'el' ? 'Από ' : 'By '}
              <a href={languagePath(lang, `authors/${author.slug}`)}>{author.name}</a>
            </span>}
            <span aria-hidden="true"> · </span>
            <time datetime={article.date}>{formatPublicationDate(article.date, lang)}</time>
          </p>
          {article.tags && article.tags.length > 0 && (
            <ul class="article-tags" aria-label={lang === 'el' ? 'Ετικέτες' : 'Tags'}>
              {article.tags.map((tag) => <li><a href={languagePath(lang, `tags/${tag}`)}>{tag}</a></li>)}
            </ul>
          )}
        </header>

        {article.image ? (
          <figure class="article-hero">
            <ResponsiveImage src={article.image} alt={article.imageAlt?.[lang] ?? ''} variant="hero" loading="eager" />
            {article.imageCredit?.[lang] && <figcaption>
              {article.imageSource ? <a href={article.imageSource}>{article.imageCredit[lang]}</a> : article.imageCredit[lang]}
            </figcaption>}
          </figure>
        ) : (
          <div class="article-hero-placeholder" aria-hidden="true"></div>
        )}

        <div class="article-body">
          {sections.length > 0 ? sections.map((section) => {
            if (section.type === 'heading') return <h2>{section.text[lang]}</h2>;
            if (section.type === 'quote') return (
              <blockquote>
                <p>{section.text[lang]}</p>
                {section.attribution?.[lang] && <cite>{section.attribution[lang]}</cite>}
              </blockquote>
            );
            return <p>{section.text[lang]}</p>;
          }) : body.length > 0 ? body.map((paragraph) => <p>{paragraph}</p>) : (
            <p class="article-placeholder">
              {lang === 'el'
                ? 'Το άρθρο είναι ακόμη προσχέδιο. Το layout είναι έτοιμο για το τελικό κείμενο.'
                : 'This story is still a draft. The layout is ready for the final copy.'}
            </p>
          )}
        </div>

        {related.length > 0 && (
          <section class="article-related" aria-labelledby="related-heading">
            <div class="section-heading-row">
              <h2 id="related-heading">{lang === 'el' ? 'Συνέχισε την ανάγνωση' : 'Continue reading'}</h2>
              <a href={languagePath(lang, 'archive')}>
                {lang === 'el' ? 'Όλα τα άρθρα' : 'All stories'}
              </a>
            </div>
            <div class="article-related__grid">
              {related.map((item) => (
                <article>
                  <p class="story-meta"><time datetime={item.date}>{formatPublicationDate(item.date, lang)}</time></p>
                  <h3><a href={languagePath(lang, `articles/${item.slug}`)}>{item.title[lang]}</a></h3>
                  <p>{item.dek[lang]}</p>
                </article>
              ))}
            </div>
          </section>
        )}

        {(newer || older) && (
          <nav class="article-pager" aria-label={lang === 'el' ? 'Πλοήγηση άρθρων' : 'Article navigation'}>
            <div>
              {newer && (
                <a href={languagePath(lang, `articles/${newer.slug}`)}>
                  <span>{lang === 'el' ? '← Νεότερο' : '← Newer'}</span>
                  <strong>{newer.title[lang]}</strong>
                </a>
              )}
            </div>
            <div>
              {older && (
                <a href={languagePath(lang, `articles/${older.slug}`)}>
                  <span>{lang === 'el' ? 'Παλαιότερο →' : 'Older →'}</span>
                  <strong>{older.title[lang]}</strong>
                </a>
              )}
            </div>
          </nav>
        )}
      </article>
    </main>
    <EditorialFooter lang={lang} />
  </div>
</BaseLayout>
