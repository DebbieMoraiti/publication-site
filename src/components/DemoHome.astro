---
import { enabledSections, siteConfig } from '../config';
import { ui, type LanguageCode } from '../i18n/ui';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import HeroSection from './sections/HeroSection.astro';
import SectionFrame from './sections/SectionFrame.astro';
import AboutSection from './sections/AboutSection.astro';
import CardSection from './sections/CardSection.astro';
import MediaSection from './sections/MediaSection.astro';
import LiveSection from './sections/LiveSection.astro';
import ContactSection from './sections/ContactSection.astro';
import PressKitSection from './sections/PressKitSection.astro';
import projects from '../content/projects.json';
import discography from '../content/discography.json';
import services from '../content/services.json';

interface Props {
  lang: LanguageCode;
}

const { lang } = Astro.props;
const copy = ui[lang];
const contentSections = enabledSections.filter((section) => section.id !== 'hero');
const hasHero = enabledSections.some((section) => section.id === 'hero');
---

<BaseLayout lang={lang} skipText={copy.skipToContent}>
  <div class="site-shell" id="top">
    <SiteHeader lang={lang} />

    <main id="main-content" tabindex="-1">
      {!hasHero && <h1 class="visually-hidden">{siteConfig.identity.name}</h1>}
      {enabledSections.map((section) => section.id === 'hero' ? (
        <HeroSection lang={lang} />
      ) : (
        <SectionFrame
          section={section}
          lang={lang}
          number={contentSections.findIndex((item) => item.id === section.id) + 1}
          alternate={contentSections.findIndex((item) => item.id === section.id) % 2 === 1}
        >
          {section.id === 'about' && <AboutSection lang={lang} />}
          {section.id === 'projects' && <CardSection lang={lang} intro={projects.intro} items={projects.items} />}
          {section.id === 'discography' && <CardSection lang={lang} intro={discography.intro} items={discography.items} />}
          {section.id === 'media' && <MediaSection lang={lang} />}
          {section.id === 'live' && <LiveSection lang={lang} />}
          {section.id === 'services' && <CardSection lang={lang} intro={services.intro} items={services.items} />}
          {section.id === 'contact' && <ContactSection lang={lang} />}
          {section.id === 'pressKit' && <PressKitSection lang={lang} />}
        </SectionFrame>
      ))}
    </main>

    <SiteFooter lang={lang} />
  </div>
</BaseLayout>
