---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialHeader from './EditorialHeader.astro';
import EditorialFooter from './EditorialFooter.astro';
import { sortedVisibleArticles, articleTags } from '../content/publication-data';
import publication from '../content/publication.json';
import { languagePath, type LanguageCode } from '../i18n/routes';
import { topicBySlug, tagBySlug } from '../content/editorial';
import { publicationCollectionSchema } from '../lib/publication-schema';

interface Props { lang: LanguageCode; tag: string; }
const { lang, tag } = Astro.props;
const definition = tagBySlug.get(tag);
if (!definition) throw new Error(`Unknown tag: ${tag}`);
const related = sortedVisibleArticles().filter((article) => articleTags(article).some((item) => item.slug === definition.slug));
const label = definition.label[lang];
const pageDescription = lang === 'el' ? `Άρθρα με την ετικέτα ${label}.` : `Stories tagged ${label}.`;
const schema = publicationCollectionSchema(lang, `tags/${definition.slug}`, `#${label}`, pageDescription);
---

<BaseLayout
  lang={lang}
  title={`#${label} — ${publication.identity.name}`}
  description={pageDescription}
  structuredData={schema}
  canonicalPage={`tags/${definition.slug}`}
>
  <div class="site-shell publication-shell" id="top">
    <EditorialHeader lang={lang} />
    <main id="main-content" tabindex="-1">
      <section class="taxonomy-page content-container">
        <nav class="editorial-breadcrumbs" aria-label={lang === 'el' ? 'Πλοήγηση' : 'Breadcrumb'}>
          <a href={languagePath(lang)}>{lang === 'el' ? 'Αρχική' : 'Home'}</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">#{label}</span>
        </nav>
        <p class="publication-kicker">{lang === 'el' ? 'Ετικέτα' : 'Tag'}</p>
        <h1>#{label}</h1>
        <p class="taxonomy-count">{related.length} {lang === 'el' ? (related.length === 1 ? 'άρθρο' : 'άρθρα') : (related.length === 1 ? 'story' : 'stories')}</p>
        <div class="taxonomy-list">
          {related.map((article) => (
            <article>
              <p class="story-meta">{topicBySlug.get(article.topicSlug)?.label[lang] ?? article.topic?.[lang] ?? article.topicSlug} · {article.date}</p>
              <h2><a href={languagePath(lang, `articles/${article.slug}`)}>{article.title[lang]}</a></h2>
              <p>{article.dek[lang]}</p>
            </article>
          ))}
        </div>
      </section>
    </main>
    <EditorialFooter lang={lang} />
  </div>
</BaseLayout>
