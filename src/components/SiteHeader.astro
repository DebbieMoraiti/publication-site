---
import { enabledSections, moduleConfig, siteConfig } from '../config';
import { ui, type LanguageCode } from '../i18n/ui';
import { languagePath, pageFromPath } from '../i18n/routes';
import AudioIntro from './AudioIntro.astro';

interface Props {
  lang: LanguageCode;
}

const { lang } = Astro.props;
const copy = ui[lang];
const navigationItems = enabledSections.filter((section) => section.showInMenu);
const page = pageFromPath(Astro.url.pathname);
---

<header
  class:list={['site-header', { 'is-sticky': moduleConfig.menu.sticky }]}
  data-site-header
  data-menu-open="false"
  data-menu-enabled={String(moduleConfig.menu.enabled)}
>
  <div class="header-inner">
    <a class="brand" href={languagePath(lang)}>
      {siteConfig.identity.name}
    </a>

    <AudioIntro lang={lang} />

    <div class="navigation-panel" data-navigation-panel>
      {moduleConfig.menu.enabled && (
        <nav
          id={`primary-navigation-${lang}`}
          class="primary-navigation"
          aria-label={lang === 'el' ? 'Κύρια πλοήγηση' : 'Primary navigation'}
        >
          <ul>
            {navigationItems.map((section) => (
              <li>
                <a href={page ? `${languagePath(lang)}#${section.id}` : `#${section.id}`}>{section.label[lang]}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>

    <nav class="language-switcher" aria-label={copy.languageLabel}>
      {siteConfig.localization.languages.map((language) => (
        <a
          href={languagePath(language.code as LanguageCode, page)}
          lang={language.code}
          hreflang={language.code}
          aria-label={language.label}
          aria-current={lang === language.code ? 'page' : undefined}
          data-language-link
          data-base-href={languagePath(language.code as LanguageCode, page)}
        >
          {language.code === 'el' ? 'ΕΛ' : 'EN'}
        </a>
      ))}
    </nav>

    {moduleConfig.menu.enabled && (
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls={`primary-navigation-${lang}`}
        data-menu-toggle
        data-open-label={copy.openMenu}
        data-close-label={copy.closeMenu}
      >
        <span class="visually-hidden" data-menu-label>{copy.openMenu}</span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    )}
  </div>
</header>

<script>
  const updateLanguageLinks = () => {
    document.querySelectorAll<HTMLAnchorElement>('[data-language-link]').forEach((link) => {
      link.href = `${link.dataset.baseHref ?? '/'}${window.location.hash}`;
    });
  };
  updateLanguageLinks();
  window.addEventListener('hashchange', updateLanguageLinks);

  document.querySelectorAll('[data-site-header]').forEach((header) => {
    const toggle = header.querySelector('[data-menu-toggle]');
    const panel = header.querySelector('[data-navigation-panel]');
    const label = header.querySelector('[data-menu-label]');

    if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

    const closeMenu = (restoreFocus = false) => {
      header.setAttribute('data-menu-open', 'false');
      toggle.setAttribute('aria-expanded', 'false');
      if (label) label.textContent = toggle.dataset.openLabel ?? '';
      if (restoreFocus && panel.contains(document.activeElement)) toggle.focus();
    };

    toggle.addEventListener('click', () => {
      const willOpen = toggle.getAttribute('aria-expanded') !== 'true';
      header.setAttribute('data-menu-open', String(willOpen));
      toggle.setAttribute('aria-expanded', String(willOpen));
      if (label) {
        label.textContent = willOpen
          ? (toggle.dataset.closeLabel ?? '')
          : (toggle.dataset.openLabel ?? '');
      }
      if (willOpen) panel.querySelector<HTMLElement>('a')?.focus();
    });

    panel.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeMenu()));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') closeMenu(true);
    });

    window.matchMedia('(min-width: 80rem)').addEventListener('change', (event) => {
      if (event.matches) closeMenu();
    });
  });
</script>
