---
import { siteConfig } from '../config';
import publication from '../content/publication.json';
import { topicBySlug } from '../content/editorial';
import { topicIsActive } from '../lib/topic-visibility';
import { assetPath, languagePath, pageFromPath, type LanguageCode } from '../i18n/routes';

interface Props { lang: LanguageCode; }
const { lang } = Astro.props;
const page = pageFromPath(Astro.url.pathname);
const homeSection = (id: string) => page ? `${languagePath(lang)}#${id}` : `#${id}`;
const isCurrent = (target: string) => page === target || page.startsWith(`${target}/`);
const logo = siteConfig.branding.logo;
const navTopics = ['people', 'ideas', 'music', 'everyday-life', 'culture'].filter((slug) => topicIsActive(slug, topicBySlug));
const wordmarkSizes = page ? '(max-width: 576px) calc(100vw - 32px), 512px' : '(max-width: 928px) calc(100vw - 32px), 864px';
const wordmarkSrcset = logo === '/brand/storyfields-wordmark.webp'
  ? [400, 800, 1600].map((width) => `${assetPath(width === 1600 ? logo : `/brand/storyfields-wordmark-${width}.webp`)} ${width}w`).join(', ')
  : undefined;
const labels = lang === 'el'
  ? { stories: 'Ιστορίες', people: 'Άνθρωποι', ideas: 'Ιδέες', music: 'Μουσική', everyday: 'Καθημερινότητα', culture: 'Πολιτισμός', archive: 'Αρχείο', contact: 'Επικοινωνία', menu: 'Πλοήγηση', edition: 'Ανεξάρτητη έκδοση', location: 'Αθήνα' }
  : { stories: 'Stories', people: 'People', ideas: 'Ideas', music: 'Music', everyday: 'Everyday life', culture: 'Culture', archive: 'Archive', contact: 'Contact', menu: 'Navigation', edition: 'Independent publication', location: 'Athens' };
---

<header class:list={['editorial-header', { 'editorial-header--compact': !!page }]}>
  <div class="newspaper-topline content-container">
    <span>{labels.edition}</span>
    <span>Storyfields · {labels.location}</span>
  </div>

  <div class="newspaper-masthead content-container">
    <a class="editorial-brand" href={languagePath(lang)} aria-label={publication.identity.name}>
      {logo ? (
        <>
          <img class="editorial-wordmark" src={assetPath(logo)} srcset={wordmarkSrcset} sizes={wordmarkSizes} width="1600" height="255" alt="" decoding="async" fetchpriority="high" />
          <span class="visually-hidden">{publication.identity.name}</span>
        </>
      ) : publication.identity.name}
    </a>
    <p>{publication.identity.tagline[lang]}</p>
  </div>

  <div class="editorial-header__inner content-container">
    <nav class="editorial-nav" aria-label={labels.menu}>
      <a href={homeSection('stories')} aria-current={!page ? 'page' : undefined}>{labels.stories}</a>
      {navTopics.map((slug) => <a href={languagePath(lang, `topics/${slug}`)} aria-current={isCurrent(`topics/${slug}`) ? 'page' : undefined}>{topicBySlug.get(slug)!.label[lang]}</a>)}
      <a href={languagePath(lang, 'archive')} aria-current={isCurrent('archive') ? 'page' : undefined}>{labels.archive}</a>
      <a href={languagePath(lang, 'contact')} aria-current={isCurrent('contact') ? 'page' : undefined}>{labels.contact}</a>
    </nav>

    <nav class="editorial-languages" aria-label={lang === 'el' ? 'Γλώσσα' : 'Language'}>
      {siteConfig.localization.languages.map((language) => (
        <a
          href={languagePath(language.code as LanguageCode, page)}
          lang={language.code}
          hreflang={language.code}
          aria-current={lang === language.code ? 'page' : undefined}
        >
          {language.code === 'el' ? 'ΕΛ' : 'EN'}
        </a>
      ))}
    </nav>
  </div>
</header>
